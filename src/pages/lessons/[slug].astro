---
import Layout from '../../layouts/Layout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { lessons, moreOf } from '../../data/content';
import { levelOf, levelLabel, neighbors, sessionPlan, thumb, url, absoluteUrl, orderedLessons } from '../../lib/helpers';

export function getStaticPaths() {
  return lessons.map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson } }));
}

const { lesson } = Astro.props;
const level = levelOf(lesson);
const { prev, next } = neighbors(lesson);
const plan = sessionPlan(lesson.minutes);
const more = moreOf(lesson.slug);
const number = orderedLessons.findIndex((l) => l.slug === lesson.slug) + 1;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('') },
      { '@type': 'ListItem', position: 2, name: level.name, item: absoluteUrl(`levels/${level.id}/`) },
      { '@type': 'ListItem', position: 3, name: lesson.title, item: absoluteUrl(`lessons/${lesson.slug}/`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: lesson.title,
    description: lesson.summary,
    inLanguage: 'en',
    learningResourceType: 'Video lesson',
    timeRequired: `PT${plan.days === 2 ? 60 : 30}M`,
    image: thumb(lesson.videoId),
    isPartOf: { '@type': 'Course', name: `Shuffle dance: ${level.name}`, url: absoluteUrl(`levels/${level.id}/`) },
  },
];
---

<Layout
  title={lesson.title}
  description={`${lesson.summary} ${levelLabel(level)} of the shuffle dance learning path, with a 30-minute practice plan.`}
  path={`lessons/${lesson.slug}/`}
  image={thumb(lesson.videoId)}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={url('')}>Home</a> / <a href={url(`levels/${level.id}/`)}>{level.name}</a> / Lesson {number}
    </nav>

    <div class="lesson-layout">
      <div>
        <VideoPlayer videoId={lesson.videoId} title={lesson.title} start={lesson.start} end={lesson.end} />
        <p class="note" style="margin-top: 10px;">
          {lesson.channel} · {lesson.minutes} min ·
          <a href={`https://www.youtube.com/watch?v=${lesson.videoId}`} target="_blank" rel="noopener">Watch on YouTube</a>
        </p>
      </div>

      <div>
        <span class="eyebrow">{levelLabel(level)} · {level.name}</span>
        <h1 style="font-size: clamp(1.5rem, 5vw, 2.2rem);">{lesson.title}</h1>
        <p>{lesson.summary}</p>

        {lesson.chapters && (
          <div class="panel" style="margin-bottom: 14px;">
            <h2>In this video</h2>
            <ul class="chapters">
              {lesson.chapters.map((c) => {
                const [time, ...rest] = c.split(' ');
                return <li><span class="time">{time}</span> {rest.join(' ')}</li>;
              })}
            </ul>
            <p class="note" style="margin: 8px 0 0;">Use the video's own chapters to jump to the part you need.</p>
          </div>
        )}

        <div class="panel" style="margin-bottom: 14px;">
          <h2>Focus on</h2>
          <ul>{lesson.focus.map((f) => <li>{f}</li>)}</ul>
        </div>

        <div class="panel">
          <h2>Today's session{plan.days === 2 ? ' (plan 2 days)' : ''}</h2>
          <div class="plan">
            <div><strong>{plan.warmup}</strong><span>min warm-up</span></div>
            <div><strong>{plan.watch}</strong><span>min watch</span></div>
            <div><strong>{plan.practice}</strong><span>min practice</span></div>
          </div>
          <p class="note" style="margin: 0;">
            Warm up by stepping to a steady beat. Then watch, pause often, and practice along.
            {plan.days === 2 && ' This is a long video, so split it across two sessions.'}
          </p>
        </div>

        <p style="margin-top: 16px;">
          <button class="btn" type="button" data-complete-btn={lesson.slug} aria-pressed="false">Mark as complete</button>
        </p>
      </div>
    </div>

    {more.length > 0 && (
      <section aria-labelledby="more-h" class="more">
        <h2 id="more-h">More tutorials on this topic</h2>
        <p class="note">Same topic, different teachers. If the main video does not click, try another explanation.</p>
        <div class="grid three">
          {more.map((v) => (
            <article class="card hl-card">
              <VideoPlayer videoId={v.videoId} title={v.title} />
              <div class="info">
                <h3>{v.title}</h3>
                <p class="note" style="margin: 0;">
                  {v.channel} · {v.minutes} min ·
                  <a href={`https://www.youtube.com/watch?v=${v.videoId}`} target="_blank" rel="noopener">YouTube</a>
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="pager">
      {prev ? <a class="btn alt" href={url(`lessons/${prev.slug}/`)}>← Previous</a> : <span />}
      {next ? <a class="btn" href={url(`lessons/${next.slug}/`)}>Next lesson →</a> : <a class="btn" href={url('highlights/')}>Get inspired 🔥</a>}
    </div>
    <div style="height: 40px;"></div>
  </div>
</Layout>
