---
import Layout from '../layouts/Layout.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { highlights, VIEWS_AS_OF } from '../data/content';
import { formatViews, absoluteUrl } from '../lib/helpers';

const styleLabel = { melbourne: 'Melbourne', 'cutting-shapes': 'Cutting shapes', general: 'General' } as const;
const sorted = [...highlights].sort((a, b) => b.views - a.views);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('') },
      { '@type': 'ListItem', position: 2, name: 'Highlights', item: absoluteUrl('highlights/') },
    ],
  },
];
---

<Layout
  title="Best Shuffle Dance Videos and Shorts"
  description="Get motivated with the most-watched shuffle dance videos and shorts, covering Melbourne shuffle and cutting shapes. Filter by style and sort by views."
  path="highlights/"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">Hall of fame</span>
      <h1>Get <span class="grad">hyped</span></h1>
      <p class="lead">Watch these when you need motivation. This is what a few months of practice can turn into.</p>
    </section>

    <div class="filters" role="group" aria-label="Filter by format" data-filter-group="format">
      <button class="chip" type="button" data-value="all" aria-pressed="true">All</button>
      <button class="chip" type="button" data-value="full" aria-pressed="false">Full videos</button>
      <button class="chip" type="button" data-value="short" aria-pressed="false">Shorts</button>
    </div>
    <div class="filters" role="group" aria-label="Filter by style" data-filter-group="style">
      <button class="chip" type="button" data-value="all" aria-pressed="true">All styles</button>
      <button class="chip" type="button" data-value="melbourne" aria-pressed="false">Melbourne</button>
      <button class="chip" type="button" data-value="cutting-shapes" aria-pressed="false">Cutting shapes</button>
      <button class="chip" type="button" data-value="general" aria-pressed="false">General</button>
    </div>

    <p class="note" id="count" aria-live="polite"></p>

    <div class="grid three" id="cards">
      {sorted.map((h) => (
        <article class="card hl-card" data-format={h.isShort ? 'short' : 'full'} data-style={h.style}>
          <VideoPlayer videoId={h.videoId} title={h.title} short={h.isShort} />
          <div class="info">
            <span class="tag">{h.isShort ? 'Short' : 'Video'} · {styleLabel[h.style]}</span>
            <h3>{h.title}</h3>
            <p class="note" style="margin: 0;">
              {h.channel} · <span class="views">{formatViews(h.views)} views</span>
            </p>
          </div>
        </article>
      ))}
    </div>

    <p class="note" style="margin: 24px 0 40px;">
      View counts are from {VIEWS_AS_OF} and will have changed since. Styles are rough tags.
    </p>
  </div>
</Layout>

<script>
  const state = { format: 'all', style: 'all' };
  const cards = [...document.querySelectorAll<HTMLElement>('#cards .hl-card')];
  const count = document.getElementById('count')!;

  function apply() {
    let shown = 0;
    for (const c of cards) {
      const ok =
        (state.format === 'all' || c.dataset.format === state.format) &&
        (state.style === 'all' || c.dataset.style === state.style);
      c.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = `${shown} video${shown === 1 ? '' : 's'}, sorted by views`;
  }

  document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
    const key = group.dataset.filterGroup as 'format' | 'style';
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!btn) return;
      state[key] = btn.dataset.value!;
      group.querySelectorAll('.chip').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      apply();
    });
  });

  apply();
</script>
