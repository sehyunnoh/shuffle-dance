---
import Layout from '../../layouts/Layout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { mainLevels, melbourneLevel, lessonsOf, url, absoluteUrl } from '../../lib/helpers';

const all = [...mainLevels, melbourneLevel];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('') },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: absoluteUrl('levels/') },
    ],
  },
];
---

<Layout
  title="Shuffle Dance Levels: From Beginner to Routine"
  description="All the levels in the shuffle dance learning path: foundations, first combos, cutting shapes, flow and routines, plus an optional Melbourne shuffle track."
  path="levels/"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">Learn</span>
      <h1>Pick your <span class="grad">level</span></h1>
      <p class="lead">Do them in order. Each lesson is built for one 30-minute practice session.</p>
    </section>
    <div class="grid">
      {all.map((lv) => {
        const ls = lessonsOf(lv.id);
        return (
          <a class="card" href={url(`levels/${lv.id}/`)}>
            <div class="num">{lv.number ?? '★'}</div>
            <h3>{lv.name}</h3>
            <p class="muted">{lv.goal}</p>
            <p class="note">{ls.length} lessons</p>
            <ProgressBar slugs={ls.map((l) => l.slug)} />
          </a>
        );
      })}
    </div>
  </div>
</Layout>
