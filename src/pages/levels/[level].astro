---
import Layout from '../../layouts/Layout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { levels } from '../../data/content';
import { lessonsOf, levelLabel, thumb, url, absoluteUrl } from '../../lib/helpers';

export function getStaticPaths() {
  return levels.map((level) => ({ params: { level: level.id }, props: { level } }));
}

const { level } = Astro.props;
const ls = lessonsOf(level.id);
const label = levelLabel(level);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('') },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: absoluteUrl('levels/') },
      { '@type': 'ListItem', position: 3, name: level.name, item: absoluteUrl(`levels/${level.id}/`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${label}: ${level.name}`,
    itemListElement: ls.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: l.title,
      url: absoluteUrl(`lessons/${l.slug}/`),
    })),
  },
];
---

<Layout
  title={`${label}: ${level.name} (Shuffle Dance)`}
  description={`${level.goal} ${ls.length} hand-picked shuffle dance video lessons with practice tips.`}
  path={`levels/${level.id}/`}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={url('')}>Home</a> / <a href={url('levels/')}>Learn</a> / {level.name}
    </nav>
    <section class="hero">
      <span class="eyebrow">{label}</span>
      <h1>{level.name}</h1>
      <p class="lead">{level.goal}</p>
      <ProgressBar slugs={ls.map((l) => l.slug)} />
    </section>

    <ol class="lesson-list">
      {ls.map((l, i) => (
        <li>
          <a class="card lesson-row" href={url(`lessons/${l.slug}/`)}>
            <img src={thumb(l.videoId)} alt="" loading="lazy" width="120" height="68" />
            <div>
              <h3>{i + 1}. {l.title}</h3>
              <div class="meta">{l.channel} · {l.minutes} min video</div>
            </div>
            <span class="check" data-lesson-check={l.slug} aria-label="Completed">✓</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Layout>
