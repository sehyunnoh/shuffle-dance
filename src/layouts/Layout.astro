---
import '../styles/global.css';
import { SITE_NAME, url, absoluteUrl, orderedLessons } from '../lib/helpers';

interface Props {
  title: string;
  description: string;
  path: string; // site-relative path, e.g. "levels/foundations/"
  image?: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, path, image, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = path === '' ? title : `${title} | ${SITE_NAME}`;
const canonical = absoluteUrl(path);
const current = Astro.url.pathname;
const isActive = (p: string) => {
  const target = url(p);
  return p === '' ? current === target : current.startsWith(target);
};
const nav = [
  { href: '', label: 'Home', icon: '🏠' },
  { href: 'levels/', label: 'Learn', icon: '👟' },
  { href: 'highlights/', label: 'Highlights', icon: '🔥' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0716" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={url('')}>Shuffle <span>Lab</span></a>
        <nav class="top-nav" aria-label="Main">
          {nav.map((n) => <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Shuffle Lab is a free practice guide. All videos belong to their creators and play from YouTube.
          View counts were collected on 2026-10-09.
        </p>
      </div>
    </footer>

    <nav class="bottom-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>
          <span class="ico" aria-hidden="true">{n.icon}</span>{n.label}
        </a>
      ))}
    </nav>

    <script type="application/json" id="lesson-order" set:html={JSON.stringify(orderedLessons.map((l) => l.slug))} />
    <script>
      import '../scripts/progress.ts';
    </script>
  </body>
</html>
