---
import '../styles/global.css';
import { SITE_NAME, url, absoluteUrl, orderedLessons, clip } from '../lib/helpers';

interface Props {
  title: string;
  description: string;
  path: string; // site-relative path, e.g. "levels/foundations/"
  image?: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description: rawDescription, path, image, jsonLd = [], noindex = false } = Astro.props;
// Keep titles under ~60 characters and descriptions under ~160 so search results don't cut them off.
const suffix = ` | ${SITE_NAME}`;
const fullTitle = path === '' ? clip(title, 60) : `${clip(title, 60 - suffix.length)}${suffix}`;
const description = clip(rawDescription, 158);
const canonical = absoluteUrl(path);
const ogImage = image ?? absoluteUrl('og-default.png');
const current = Astro.url.pathname;
const isActive = (p: string) => {
  const target = url(p);
  return p === '' ? current === target : current.startsWith(target);
};
const nav = [
  { href: '', label: 'Home', icon: '🏠' },
  { href: 'levels/', label: 'Learn', icon: '👟' },
  { href: 'highlights/', label: 'Highlights', icon: '🔥' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0716" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="b6ZUrFva2Rg41gdVhtstA3MdOOjZfrld8tBxLsiZI3g" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={url('')}>Shuffle <span>Lab</span></a>
        <nav class="top-nav" aria-label="Main">
          {nav.map((n) => <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Shuffle Lab is a free practice guide. All videos belong to their creators and play from YouTube.
          View counts were collected on 2026-10-09.        </p>
      </div>
    </footer>

    <nav class="bottom-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>
          <span class="ico" aria-hidden="true">{n.icon}</span>{n.label}
        </a>
      ))}
    </nav>

    <!-- GoatCounter: privacy-friendly, cookie-free analytics (it ignores localhost by default) -->
    <script is:inline data-goatcounter="https://shuffledance.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <script type="application/json" id="lesson-order" set:html={JSON.stringify(orderedLessons.map((l) => l.slug))} />
    <script>
      import '../scripts/progress.ts';
    </script>
  </body>
</html>
